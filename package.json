{
  "name": "shotly",
  "private": true,
  "version": "0.12.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "typecheck": "tsc --noEmit",
    "bundle": "set -a; [ -f .env.release ] && . ./.env.release; set +a; APPLE_SIGNING_IDENTITY='Shotly Local Signing' TAURI_SIGNING_PRIVATE_KEY=\"$HOME/.tauri/shotly.key\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD='' tauri build --debug --bundles app && npm run install-local",
    "install-local": "rm -rf '/Applications/Shotly.app' && cp -R src-tauri/target/debug/bundle/macos/Shotly.app '/Applications/Shotly.app' && /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f '/Applications/Shotly.app' && echo 'installed to /Applications/Shotly.app'",
    "release": "set -a; [ -f .env.release ] && . ./.env.release; set +a; APPLE_SIGNING_IDENTITY=\"${APPLE_SIGNING_IDENTITY:-Shotly Local Signing}\" TAURI_SIGNING_PRIVATE_KEY=\"$HOME/.tauri/shotly.key\" TAURI_SIGNING_PRIVATE_KEY_PASSWORD='' tauri build --bundles app,dmg",
    "preflight": "set -a; [ -f .env.release ] && . ./.env.release; set +a; node scripts/check-google-client.mjs",
    "publish": "npm run preflight && npm run release && node scripts/publish.mjs",
    "bump": "node scripts/bump.mjs",
    "test": "vitest run",
    "parity": "node scripts/check-platform-parity.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
