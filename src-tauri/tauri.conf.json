{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shotly",
  "version": "0.8.1",
  "identifier": "com.skuirrels.shotly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "editor",
        "url": "index.html",
        "title": "Shotly",
        "width": 1280,
        "height": 840,
        "minWidth": 880,
        "minHeight": 600,
        "visible": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0B0C0E",
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**", "$DOCUMENT/Shotly/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/skuirrels/shotly/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3RUI3QkY5ODg2NTg5Q0IKUldUTGlXV0krWHZybDlHZmU4blJLbkFiQVlVR3o2dWQ2QVFDTi9QTHJnK0g1ZHFZZlF0YTljajcK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "Capture, annotate, ship.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
