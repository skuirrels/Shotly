# Copy to .env.release (gitignored) and fill in from the Google Cloud console:
#   console.cloud.google.com/auth/clients → your Desktop app client.
#
# `npm run release` and `npm run bundle` source this file, so the values end up
# compiled into the binary and never in the repository. A build without it still
# runs — it just has nothing to connect to, and Settings says so.
SHOTLY_GOOGLE_CLIENT_ID=
SHOTLY_GOOGLE_CLIENT_SECRET=
